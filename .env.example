# Copiar a .env y completar. Nunca subir el .env al repositorio.
NODE_ENV=development
PORT=8080

MONGO_URL=mongodb://127.0.0.1:27017/eventos_backend2

# Mínimo 32 caracteres. Generar con:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración del token y de la cookie, en segundos (3600 = 1 hora)
JWT_EXPIRES_IN=3600
COOKIE_NAME=accessToken

BCRYPT_SALT_ROUNDS=12
# Intentos de login permitidos por IP cada 15 minutos
LOGIN_RATE_LIMIT=10

# Contraseña de los usuarios de prueba que crea `npm run seed`
SEED_PASSWORD=
